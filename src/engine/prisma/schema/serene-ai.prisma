// Serene AI

// LLM cache
//
// Keyed on the model id (not on a Tech row): the model to use for each AI
// task comes from the environment (see src/services/ai/ai-model-service.ts),
// so there is no model catalogue in the database to reference.

model LlmCache {
  id                           String               @id @default(cuid())
  modelId                      String               @map("model_id")
  key                          String
  inputMessage                 String               @map("input_message")
  outputMessage                String?              @map("output_message")
  outputJson                   Json?                @map("output_json")
  created                      DateTime             @default(now())

  @@unique([key, modelId])
  @@map("llm_cache")
}
